#!/usr/bin/env bash

dir='/tmp/rund'

usage(){
    local subcmd="$1"
    echo -e "Usage: rnmn ${subcmd:-<subcmd>} [opts]\n"

    case "$subcmd" in
        "start")
            cat << EOF

Options:

    -t <threads>        Max threads for simulation use (default 16)
    -s <simulations>    Number of simulations to pre-allocate memory for (default 12)
    -l <log level>      Verbosity 
                          0 => silent  
                          1 => standard (default)
                          2 => debug
EOF
            ;;
        "exit")
            echo -e "\tKill the running server"
            cat << EOF

Options:

    -w      Wait for the running simulations to finish (default)
    -f      Force, send SIGKILL to the server
EOF
            ;;
        "run")
            echo -e "\t Add a simulation to the queue"
            cat << EOF

Options (specified in submission script):

    threads     Number of threads the simulation will use
    
EOF
            ;;
        "status")
            echo -e "\tView the currently running simulations, as well as the simulations waiting in the queue\n";;
        *) 
          echo -e 'Please specify a subcommand:\nstart   -- start the server if it does not exist, or restart it if it does\nexit    -- kill the server\nrun     -- add a simulation to the queue\nstatus  -- view status of rnmn\nhelp    -- print this message\nversion -- print the version of Running Man'
          echo -e "\nuse rnmn help <subcmd> for subcommand options"
            ;;
    esac
}

fatal() {
    echo "ERROR: $1" >&2
    exit 1
}

status() {
  echo 'status' 2>/dev/null > "$dir/command" 

  sleep 1

  cat "$dir/status"  2>/dev/null || echo "Error: rnmnd not started" >&2 
}

run() {
  echo "$PWD/$1"
  echo 'run' >"$dir/command"
  sleep 0
  echo -n "$PWD/$1" >"$dir/command"
}

exit_fn() {
    while getopts "wf" opt; do
        case $opt in 
            "w") echo 'exit' >"$dir/command";;
            "f") kill -9 $(pgrep rnmnd);;
            *) usage "exit" >&2; exit 1;;
        esac
    done
}

start(){
    mkdir -p ~/.cache/rnmn/
    # if the server is already started, then re-start it
    local proc=$(pgrep rnmnd)
    local threads=16 sims=12 log_level=1

    while getopts "t:s:l:h" opt; do
        case "$opt" in
            t) threads=$OPTARG;;
            s) sims=$OPTARG;;
            l) log_level=$OPTARG;;
            h) usage "start"; exit 0;;
            *) usage "start" >&2; exit 1;;
        esac
    done
    if [[ -n  $proc ]]; then 
        kill "$proc" &2>/dev/null
    fi
    rnmnd -n "$sims" -l "$log_level" -t "$threads" > ~/.cache/rnmn/stdout.log 2>~/.cache/rnmn/stderr.log & disown
}

version(){
    local RNMN_VERSION
    echo "version" > "$dir/command"
    RNMN_VERSION=$(cat "$dir/status")
    echo -e "Running Man simulation manager\nVersion $RNMN_VERSION\nThis software is distributed with no waranty of any kind"
}

main(){
    case "$1" in
    '') usage >&2;
      exit 1
      ;;
    'help')
        shift
        usage "$@" ;;
    'start')
        shift
        start "$@" 
        ;;
    'exit')
      exit_fn
      ;;
    'status')
      status
      ;;
  'version')
      version
      ;;
    'run')
      run "$2"
      ;;
    *)
      echo 'Invalid Command!'
      exit 1
      ;;
    esac
}

main "$@"
